# Environment Configuration
ENV=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_safety_monitoring
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_safety_monitoring
DB_USER=postgres
DB_PASSWORD=password

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=iot/safety

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=safety-system@example.com
ALERT_EMAIL_TO=admin@example.com

# SMS Configuration (Twilio or similar)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
ALERT_PHONE_NUMBER=+1234567890

# AI Model Configuration
AI_MODEL_PATH=./models
AI_CONFIDENCE_THRESHOLD=0.75
ANOMALY_DETECTION_SENSITIVITY=medium

# Sensor Thresholds
GAS_WARNING_THRESHOLD=50
GAS_DANGER_THRESHOLD=100
TEMP_WARNING_THRESHOLD=35
TEMP_DANGER_THRESHOLD=45
VIBRATION_WARNING_THRESHOLD=5
VIBRATION_DANGER_THRESHOLD=10
PROXIMITY_WARNING_THRESHOLD=50
PROXIMITY_DANGER_THRESHOLD=20

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
